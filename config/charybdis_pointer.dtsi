#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/input_transform.h>

&trackball_listener {
    /*
     * The sensor is mounted mirrored on both axes relative to how ZMK expects
     * it, so up read as down and left read as right. Invert both before any
     * other processing, so every downstream consumer sees correct motion.
     */
    input-processors = <
        &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
        &zip_xy_scaler 3 5
    >;
};

/ {
    /*
     * Kept for later: this is what drives the "move the ball, jump to a mouse
     * layer" behaviour, plus trackball-as-arrow-keys. Neither is wired into the
     * chain above, because the current keymap only defines layers 0-2 and these
     * referenced layers 1, 3, 4 and 6. Re-point them at real layers and add them
     * back to input-processors to re-enable.
     */
    auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <0>;
        excluded-positions = <30 31 32 33 34 35>;
    };

    caret_input: caret_input {
        compatible = "zmk,input-processor-caret";
        #input-processor-cells = <0>;
        threshold = <64>;
        bindings = <&kp LEFT>, <&kp RIGHT>, <&kp UP>, <&kp DOWN>;
    };
};
